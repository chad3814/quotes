# Neon Postgres connection strings.
# Copy this file to .env.local and fill in the values from the Neon dashboard.

# Pooled connection (PgBouncer). Used by the app runtime (src/db/client.ts) —
# safe for serverless where many short-lived connections are opened.
DATABASE_URL=

# Direct / unpooled connection. Used by drizzle-kit for migrations
# (src/../drizzle.config.ts) — DDL should not run over the pooler.
DATABASE_URL_UNPOOLED=
